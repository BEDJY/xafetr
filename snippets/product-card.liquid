<div class="product-card" data-product-id="{{ product.id }}">
  <div class="product-image-container">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 500 }}" alt="{{ product.title | escape }}" loading="lazy" class="product-img">
    {% else %}
      <img src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=500&auto=format&fit=crop" alt="Producto sin imagen" class="product-img">
    {% endif %}

    {% if product.compare_at_price > product.price %}
      {% assign save_price = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
      <span class="badge-discount">-{{ save_price }}%</span>
    {% elsif product.tags contains 'prescrito' %}
      <span class="badge-discount" style="background:#10B981;">💊 PRESCRIPCIÓN</span>
    {% endif %}

    <button class="wishlist-btn-card" title="Agregar a Favoritos" onclick="toggleWishlist('{{ product.id }}', '{{ product.title | escape }}')">❤️</button>
  </div>

  <div class="product-card-body">
    <div class="product-brand-tag">{{ product.vendor | default: 'Cobaii Petvet' }}</div>
    <a href="{{ product.url }}" class="product-title-link" style="text-decoration: none; color: inherit;">
      <h3 class="product-title">{{ product.title }}</h3>
    </a>

    <div class="product-rating">
      <span class="stars">★★★★★</span>
      <span class="reviews-count">(5.0)</span>
    </div>

    <div class="product-price-row">
      <div>
        <span class="current-price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="old-price">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
    </div>

    <form method="post" action="/cart/add" class="shopify-product-form" data-product-form>
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" class="btn-add-cart-card" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}
          🛒 Añadir al Carrito
        {% else %}
          Agotado
        {% endif %}
      </button>
    </form>
  </div>
</div>
