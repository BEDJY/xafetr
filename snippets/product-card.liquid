{% comment %}
  Renders a product card snippet in Shopify
{% endcomment %}

<div class="product-card" data-id="{{ product.id }}">
  <div class="card-img-wrapper {{ product.aspect_ratio | default: 'aspect-tall' }}">
    <a href="{{ product.url }}">
      <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" class="img-main" loading="lazy">
      {% if product.images[1] != blank %}
        <img src="{{ product.images[1] | image_url: width: 600 }}" alt="{{ product.title }}" class="img-secondary" loading="lazy">
      {% endif %}
    </a>

    {% if product.variants.size > 0 %}
      <div class="quick-size-bar">
        {% for variant in product.variants limit: 4 %}
          <button class="quick-size-pill" data-id="{{ product.id }}" data-variant-id="{{ variant.id }}" data-size="{{ variant.title }}">{{ variant.title }}</button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  <div class="card-body">
    <div class="card-header-row">
      <div class="card-badges">
        {% if product.compare_at_price > product.price %}
          {% assign save = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
          <span class="badge-discount">-{{ save }}%</span>
        {% endif %}
        <span class="badge-tag">👑 ROYALE</span>
      </div>
      <button class="btn-wishlist" data-id="{{ product.id }}">🤍</button>
    </div>

    <div class="card-rating">
      <span>★ 4.9</span>
      <span class="reviews-count">(84)</span>
    </div>

    <h3 class="card-title"><a href="{{ product.url }}">{{ product.title }}</a></h3>

    <div class="card-footer">
      <div>
        <span class="price-current">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="price-original">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>
    </div>
  </div>
</div>
