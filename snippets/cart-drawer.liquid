<div class="cart-drawer-overlay" id="cart-drawer-overlay">
  <div class="cart-drawer">
    <div class="cart-drawer-header">
      <div class="cart-drawer-title">
        <span>🛒 Tu Carrito VIP</span>
        <span class="cart-badge-pill" id="dock-cart-badge">{{ cart.item_count }}</span>
      </div>
      <button class="btn-close-drawer" id="btn-close-drawer">✕</button>
    </div>

    <!-- Free Shipping Progress Meter -->
    <div class="free-shipping-progress-wrapper">
      <div class="free-shipping-text-box" id="free-shipping-text">
        ¡Agrega <strong>$50.00</strong> más para Envío Express GRATIS! 🚚
      </div>
      <div class="free-shipping-progress-bar">
        <div class="free-shipping-progress-fill" id="free-shipping-progress" style="width: 0%;"></div>
      </div>
    </div>

    <!-- Empty View -->
    <div class="empty-cart-view" id="empty-cart-view" {% if cart.item_count > 0 %}style="display: none;"{% endif %}>
      <div class="empty-cart-icon">👑🛍️</div>
      <h3>Tu Carrito está Vacío</h3>
      <p>Explora nuestras colecciones exclusivas para mimar a tu mascota como se merece.</p>
    </div>

    <!-- Cart Items Container -->
    <div class="cart-items-container" id="cart-items-container">
      {% for item in cart.items %}
        <div class="cart-item">
          <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title }}" class="cart-item-img">
          <div class="cart-item-details">
            <div class="cart-item-title">{{ item.product.title }}</div>
            <small style="color: var(--text-muted); font-size: 0.72rem;">{{ item.variant.title }}</small>
            <div class="cart-item-price">{{ item.final_line_price | money }}</div>
            <div class="cart-qty-controls">
              <button class="btn-qty btn-minus" data-cart-id="{{ item.key }}">-</button>
              <span>{{ item.quantity }}</span>
              <button class="btn-qty btn-plus" data-cart-id="{{ item.key }}">+</button>
              <button class="btn-remove-item" data-cart-id="{{ item.key }}">🗑️</button>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Upsells -->
    <div class="cart-upsells-wrapper">
      <div class="cart-upsells-title">✨ Complementos Recomendados</div>
      <div class="cart-upsells-row" id="cart-upsells-container"></div>
    </div>

    <!-- Gift Wrap Checkbox -->
    <div style="padding: 12px 20px; border-top: 1px dashed rgba(0,0,0,0.1);">
      <label style="display: flex; align-items: center; gap: 8px; font-size: 0.82rem; cursor: pointer;">
        <input type="checkbox" id="cart-gift-wrap-check">
        <span>🎁 Empaque para Regalo Imperial (+ $4.99)</span>
      </label>
    </div>

    <!-- Coupon Input -->
    <div class="coupon-box">
      <input type="text" id="coupon-input" placeholder="Código de Cupón VIP (Ej: LUXE2026)" autocomplete="off">
      <button class="btn-apply-coupon" id="btn-apply-coupon">Aplicar</button>
    </div>

    <!-- Footer Summary & Checkout -->
    <div class="cart-drawer-footer">
      <div class="cart-summary-row">
        <span>Subtotal:</span>
        <strong id="cart-subtotal">{{ cart.total_price | money }}</strong>
      </div>
      <div class="cart-summary-row">
        <span>Descuento:</span>
        <strong id="cart-discount" style="color: #2e7d32;">$0.00</strong>
      </div>
      <div class="cart-summary-row total-row">
        <span>Total a Pagar:</span>
        <strong id="cart-total">{{ cart.total_price | money }}</strong>
      </div>

      <button class="btn-checkout" id="btn-checkout">💳 Procesar Pago Seguro VIP</button>

      <div class="express-pay-buttons">
        <button class="express-btn btn-apple-pay" id="btn-apple-pay">Pay</button>
        <button class="express-btn btn-google-pay" id="btn-google-pay">G Pay</button>
        <button class="express-btn btn-paypal" id="btn-paypal">PayPal</button>
      </div>
    </div>
  </div>
</div>
