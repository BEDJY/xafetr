<!-- SHOPIFY CART DRAWER -->
<div id="cartDrawer" class="cart-drawer-overlay" onclick="if(event.target === this) toggleCartDrawer()">
  <div class="cart-drawer-content">
    <div class="cart-drawer-header">
      <h3 style="font-weight: 800; font-size: 1.1rem; color: var(--primary);">🛒 Mi Carrito (<span class="cart-count-badge">{{ cart.item_count }}</span>)</h3>
      <button onclick="toggleCartDrawer()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted);">&times;</button>
    </div>

    <div id="cartDrawerItems" class="cart-drawer-body" style="padding: 16px; flex: 1; overflow-y: auto;">
      {% if cart.item_count > 0 %}
        {% for item in cart.items %}
          <div class="cart-item-row" style="display: flex; gap: 12px; margin-bottom: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--border-color); align-items: center;">
            <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;">
            <div style="flex: 1;">
              <h4 style="font-size: 0.88rem; font-weight: 700; margin-bottom: 4px; color: var(--primary);">{{ item.product.title }}</h4>
              <div style="font-size: 0.8rem; color: var(--text-muted);">{{ item.variant.title }}</div>
              <div style="font-weight: 800; font-size: 0.9rem; color: var(--accent-orange); margin-top: 4px;">{{ item.final_line_price | money }}</div>
            </div>
            <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: var(--accent-red); text-decoration: none; font-size: 1.2rem;" title="Eliminar">&times;</a>
          </div>
        {% endfor %}
      {% else %}
        <div style="text-align: center; padding: 40px 16px; color: var(--text-muted);">
          <div style="font-size: 3rem; margin-bottom: 12px;">🛒</div>
          <p style="font-weight: 700;">Tu carrito está vacío</p>
          <p style="font-size: 0.82rem; margin-top: 6px;">Explora nuestros productos y agrega lo que tu mascota necesita.</p>
        </div>
      {% endif %}
    </div>

    <div class="cart-drawer-footer" style="padding: 20px; border-top: 1px solid var(--border-color); background: #F8FAFC;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <span style="font-weight: 700; color: var(--text-muted);">Subtotal:</span>
        <span class="cart-total-label" style="font-weight: 900; font-size: 1.15rem; color: var(--primary);">{{ cart.total_price | money }}</span>
      </div>

      <form action="{{ routes.cart_url }}" method="post">
        <button type="submit" name="checkout" class="btn-checkout-full" style="width: 100%; background: var(--accent-orange); color: white; border: none; padding: 14px; border-radius: var(--radius-md); font-weight: 800; font-size: 1rem; cursor: pointer;">
          🔒 Procesar Pago / Checkout
        </button>
      </form>
    </div>
  </div>
</div>
