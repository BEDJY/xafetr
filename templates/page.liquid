<div class="page-container" style="max-width: 900px; margin: 40px auto; padding: 0 24px;">
  <h1 style="font-size: 2rem; font-weight: 900; color: var(--primary); margin-bottom: 24px;">{{ page.title }}</h1>
  <div style="background: white; padding: 32px; border-radius: 16px; border: 1px solid var(--border-color); line-height: 1.7; color: var(--text-dark);">
    {{ page.content }}
  </div>
</div>
