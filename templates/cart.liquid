<div class="cart-page-container" style="max-width: 1000px; margin: 40px auto; padding: 0 24px;">
  <h1 style="font-size: 1.8rem; font-weight: 900; color: var(--primary); margin-bottom: 24px;">Mi Carrito de Compras</h1>
  
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      <div style="background: white; border-radius: 16px; padding: 24px; border: 1px solid var(--border-color); margin-bottom: 24px;">
        {% for item in cart.items %}
          <div style="display: flex; gap: 20px; align-items: center; padding-bottom: 20px; border-bottom: 1px solid var(--border-color); margin-bottom: 20px;">
            <img src="{{ item.image | image_url: width: 150 }}" alt="{{ item.title | escape }}" style="width: 80px; height: 80px; object-fit: cover; border-radius: 10px;">
            <div style="flex: 1;">
              <h3 style="font-size: 1.05rem; font-weight: 800; color: var(--primary);">{{ item.product.title }}</h3>
              <p style="color: var(--text-muted); font-size: 0.85rem;">{{ item.variant.title }}</p>
              <div style="font-weight: 900; color: var(--accent-orange); margin-top: 6px;">{{ item.final_line_price | money }}</div>
            </div>
            <div>
              <input type="number" name="updates[]" id="updates_{{ item.key }}" value="{{ item.quantity }}" min="0" style="width: 60px; padding: 8px; border-radius: 8px; border: 1px solid var(--border-color); text-align: center;">
            </div>
            <div>
              <a href="/cart/change?line={{ forloop.index }}&quantity=0" style="color: var(--accent-red); font-weight: bold; text-decoration: none;">Eliminar</a>
            </div>
          </div>
        {% endfor %}

        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 1.2rem; font-weight: 900; margin-top: 20px;">
          <span>Total:</span>
          <span style="color: var(--primary);">{{ cart.total_price | money }}</span>
        </div>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 16px;">
        <button type="submit" name="update" style="background: #E2E8F0; color: var(--primary); border: none; padding: 14px 24px; border-radius: 12px; font-weight: 800; cursor: pointer;">Actualizar Carrito</button>
        <button type="submit" name="checkout" style="background: var(--accent-orange); color: white; border: none; padding: 14px 32px; border-radius: 12px; font-weight: 800; cursor: pointer;">🔒 Procesar Pago</button>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 60px 24px; background: white; border-radius: 16px;">
      <h2 style="font-weight: 800; color: var(--primary);">Tu carrito está vacío</h2>
      <p style="color: var(--text-muted); margin-top: 8px;">Explora la tienda y agrega los mejores productos para tus mascotas.</p>
      <a href="{{ routes.all_products_collection_url }}" class="hero-cta-btn" style="text-decoration: none; display: inline-block; margin-top: 20px;">Ver Catálogo</a>
    </div>
  {% endif %}
</div>
