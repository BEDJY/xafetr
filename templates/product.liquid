<div class="product-page-container" style="max-width: 1200px; margin: 40px auto; padding: 0 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 40px;">
  
  <div class="product-gallery">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" style="width: 100%; border-radius: 16px; border: 1px solid var(--border-color); background: white;">
    {% else %}
      <img src="https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=800&auto=format&fit=crop" alt="Producto sin imagen" style="width: 100%; border-radius: 16px;">
    {% endif %}
  </div>

  <div class="product-info-column" style="display: flex; flex-direction: column; gap: 16px;">
    <span style="font-size: 0.85rem; font-weight: 800; color: var(--accent-cyan); text-transform: uppercase;">{{ product.vendor | default: 'Cobaii Petvet' }}</span>
    <h1 style="font-size: 2rem; font-weight: 900; color: var(--primary); line-height: 1.2;">{{ product.title }}</h1>
    
    <div style="display: flex; align-items: center; gap: 16px;">
      <span style="font-size: 1.6rem; font-weight: 900; color: var(--accent-orange);">{{ product.price | money }}</span>
      {% if product.compare_at_price > product.price %}
        <span style="font-size: 1.1rem; color: var(--text-muted); text-decoration: line-through;">{{ product.compare_at_price | money }}</span>
      {% endif %}
    </div>

    <div style="font-size: 0.9rem; color: var(--text-dark); line-height: 1.6; background: white; padding: 20px; border-radius: 12px; border: 1px solid var(--border-color);">
      {{ product.description }}
    </div>

    <form method="post" action="/cart/add" style="margin-top: 10px;">
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      <button type="submit" style="width: 100%; background: var(--primary); color: white; border: none; padding: 16px; border-radius: var(--radius-md); font-weight: 800; font-size: 1.05rem; cursor: pointer;">
        🛒 Añadir al Carrito
      </button>
    </form>
  </div>

</div>
