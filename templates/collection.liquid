<div class="collection-page-container" style="max-width: 1320px; margin: 30px auto; padding: 0 24px;">
  <div style="margin-bottom: 24px;">
    <h1 style="font-size: 1.8rem; font-weight: 900; color: var(--primary);">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <p style="color: var(--text-muted); margin-top: 8px;">{{ collection.description }}</p>
    {% endif %}
  </div>

  {% section 'main-collection' %}
</div>
