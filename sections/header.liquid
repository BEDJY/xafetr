<header class="header-floating-capsule" id="main-header">
  <div class="glass-navbar-capsule">
    <!-- Brand Logo -->
    <div class="nav-brand-section">
      <a href="{{ routes.root_url }}" class="logo-badge">
        {% if settings.logo != blank %}
          <img src="{{ settings.logo | image_url: width: 180 }}" alt="{{ shop.name }}" class="brand-logo-img">
        {% else %}
          <img src="{{ 'logo2_transparent.png' | asset_url }}" alt="{{ shop.name }}" class="brand-logo-img">
        {% endif %}
      </a>
      <div class="logo-title-group">
        <span class="brand-name">{{ shop.name }}</span>
        <span class="brand-sub">ROYALE PETS</span>
      </div>
    </div>

    <!-- Actions Section -->
    <div class="nav-actions-section">
      <!-- Puntos VIP -->
      <button class="nav-action-pill points-pill" id="btn-open-vip-rewards" title="Club de Puntos VIP Royale">
        <span>👑</span> <span id="header-user-points">240</span> <span class="action-label">Pts</span>
      </button>

      <!-- Selector Multimoneda Global -->
      <div class="currency-selector-dropdown">
        <select id="currency-select" class="currency-select-pill" title="Seleccionar Moneda">
          <option value="USD">🇺🇸 USD ($)</option>
          <option value="EUR">🇪🇺 EUR (€)</option>
          <option value="MXN">🇲🇽 MXN ($)</option>
          <option value="COP">🇨🇴 COP ($)</option>
        </select>
      </div>

      <!-- Buscador -->
      <button class="nav-action-pill" id="btn-toggle-search" title="Buscar Productos">
        <span>🔍</span> <span class="action-label">Buscar</span>
      </button>

      <!-- Favoritos -->
      <button class="nav-action-pill" id="wishlist-header-btn" title="Ver Favoritos">
        <span>❤️</span> <span class="action-label">Wishlist</span>
      </button>

      <!-- Carrito -->
      <button class="nav-action-pill cart-pill" id="cart-btn" title="Ver Carrito">
        <span>🛒</span>
        <span class="cart-label-count" id="cart-badge">{{ cart.item_count }}</span>
      </button>

      <!-- Toggle Tema -->
      <button class="nav-action-pill theme-pill" id="theme-toggle-btn" title="Cambiar Tema">
        <span id="theme-icon">🌙</span>
      </button>
    </div>
  </div>

  <!-- Search Overlay -->
  <div class="header-search-overlay" id="search-overlay">
    <div class="search-overlay-container">
      <form action="{{ routes.search_url }}" method="get" role="search" class="search-overlay-input-group">
        <span class="search-icon-lg">🔍</span>
        <input type="search" name="q" id="search-input" placeholder="Escribe para buscar collares, tronos, esmoquin, spa..." autocomplete="off">
        <button type="button" class="btn-close-search" id="btn-close-search">✕</button>
      </form>
      <div class="search-suggestions" id="search-suggestions"></div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header Flotante VIP",
  "settings": []
}
{% endschema %}
