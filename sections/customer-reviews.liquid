<section style="background: white; border-radius: var(--radius-lg); padding: 24px; border: 1px solid var(--border-color); margin-top: 36px; margin-bottom: 24px;">
  <div style="text-align: center; margin-bottom: 20px;">
    <span style="font-size: 0.78rem; font-weight: 800; color: var(--accent-cyan); text-transform: uppercase;">{{ section.settings.subheading }}</span>
    <h2 style="font-weight: 900; color: var(--primary); font-size: 1.35rem;">{{ section.settings.heading }}</h2>
  </div>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px;">
    {% for block in section.blocks %}
      <div style="background:#F8FAFC; border-radius:14px; padding:16px; border:1px solid var(--border-color);" {{ block.shopify_attributes }}>
        <div style="color:#FFB703; margin-bottom:6px;">{{ block.settings.stars }}</div>
        <p style="font-size:0.84rem; color:var(--text-dark); line-height:1.4;">"{{ block.settings.review_text }}"</p>
        <div style="display:flex; align-items:center; gap:10px; margin-top:12px;">
          {% if block.settings.user_img != blank %}
            <img src="{{ block.settings.user_img | image_url: width: 100 }}" style="width:40px; height:40px; border-radius:50%; object-fit:cover;">
          {% else %}
            <div style="width:40px; height:40px; border-radius:50%; background:var(--primary); color:white; display:flex; align-items:center; justify-content:center; font-weight:bold;">🐾</div>
          {% endif %}
          <div>
            <div style="font-weight:800; font-size:0.82rem; color:var(--primary);">{{ block.settings.author_name }}</div>
            <div style="font-size:0.72rem; color:var(--text-muted);">{{ block.settings.author_location }}</div>
          </div>
        </div>
      </div>
    {% else %}
      <div style="background:#F8FAFC; border-radius:14px; padding:16px; border:1px solid var(--border-color);">
        <div style="color:#FFB703; margin-bottom:6px;">★★★★★</div>
        <p style="font-size:0.84rem; color:var(--text-dark); line-height:1.4;">"Excelente servicio y entrega rápida. Mis mascotas siempre felices con su alimento premium."</p>
        <div style="display:flex; align-items:center; gap:10px; margin-top:12px;">
          <div style="width:40px; height:40px; border-radius:50%; background:var(--primary); color:white; display:flex; align-items:center; justify-content:center; font-weight:bold;">🐾</div>
          <div>
            <div style="font-weight:800; font-size:0.82rem; color:var(--primary);">Carolina R.</div>
            <div style="font-size:0.72rem; color:var(--text-muted);">Cliente Verificado</div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Historias & Opiniones",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "HISTORIAS REALES 📸"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Mascotas Felices con Cobaii Petvet"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Reseña",
      "settings": [
        {
          "type": "text",
          "id": "stars",
          "label": "Estrellas",
          "default": "★★★★★"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Texto de la Reseña",
          "default": "A mi perro le encantó el producto. El envío llegó en pocas horas."
        },
        {
          "type": "image_picker",
          "id": "user_img",
          "label": "Foto del Cliente/Mascota"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Nombre del Cliente",
          "default": "Bobi & Carolina"
        },
        {
          "type": "text",
          "id": "author_location",
          "label": "Ubicación o Detalle",
          "default": "Santo Domingo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Historias & Opiniones"
    }
  ]
}
{% endschema %}
