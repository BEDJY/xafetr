<div class="section-toolbar">
  <div class="section-title-group">
    <h2>
      {% if collection.title %}
        {{ collection.title }}
      {% else %}
        Catálogo General
      {% endif %}
      <span style="font-size: 0.85rem; font-weight: 600; color: var(--text-muted);">({{ collection.all_products_count | default: 8 }})</span>
    </h2>
  </div>

  <div>
    <select id="sortSelect" class="sort-dropdown" onchange="location.href = this.value;">
      <option value="{{ collection.url }}?sort_by=manual">Destacados</option>
      <option value="{{ collection.url }}?sort_by=price-ascending">Precio: Menor a Mayor</option>
      <option value="{{ collection.url }}?sort_by=price-descending">Precio: Mayor a Menor</option>
      <option value="{{ collection.url }}?sort_by=best-selling">Más Vendidos</option>
    </select>
  </div>
</div>

<div class="products-grid">
  {% for product in collection.products %}
    {% render 'product-card', product: product %}
  {% else %}
    <!-- PRODUCTOS DE DEMOSTRACIÓN CUANDO LA COLECCIÓN ESTÁ VACÍA -->
    <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: white; border-radius: 16px;">
      <h3>Aún no has añadido productos en Shopify</h3>
      <p style="color: var(--text-muted); margin-top: 8px;">Ve a tu Panel de Shopify > Productos para agregar productos a esta colección.</p>
    </div>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Catálogo de Productos",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12,
      "label": "Productos por página"
    }
  ],
  "presets": [
    {
      "name": "Catálogo de Productos"
    }
  ]
}
{% endschema %}
