<footer class="footer-vip-container">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-col brand-col">
        <div class="footer-logo-group">
          <img src="{{ 'logo2_transparent.png' | asset_url }}" alt="{{ shop.name }}" class="footer-logo">
          <h3>{{ shop.name }} Royale</h3>
        </div>
        <p class="footer-desc">Accesorios e indumentaria de ultra-lujo para mascotas imperiales.</p>
        <div class="footer-social-links">
          <a href="#" class="social-badge">📷 Instagram</a>
          <a href="#" class="social-badge">🎵 TikTok</a>
          <a href="#" class="social-badge">💬 WhatsApp VIP</a>
        </div>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Colecciones VIP</h4>
        <ul class="footer-menu">
          <li><a href="{{ routes.collections_url }}">Perros Reales</a></li>
          <li><a href="{{ routes.collections_url }}">Gatos Imperiales</a></li>
          <li><a href="{{ routes.collections_url }}">Aves & Exóticos</a></li>
          <li><a href="{{ routes.collections_url }}">Dudi Pets Spa</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4 class="footer-heading">Atención al Cliente</h4>
        <ul class="footer-menu">
          <li><a href="#">Rastreo de Pedidos</a></li>
          <li><a href="#">Guía de Tallas Imperial</a></li>
          <li><a href="#">Club de Puntos VIP</a></li>
          <li><a href="#">Preguntas Frecuentes</a></li>
        </ul>
      </div>

      <div class="footer-col newsletter-col">
        <h4 class="footer-heading">Únete al Club Royale</h4>
        <p class="newsletter-desc">Recibe un 15% OFF en tu primera compra y invitaciones privadas a lanzamientos.</p>
        {% form 'customer', class: 'footer-newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]" placeholder="Tu correo electrónico..." required autocomplete="email">
          <button type="submit" class="btn-checkout" style="margin-top: 8px;">👑 Suscribirme</button>
        {% endform %}
      </div>
    </div>

    <div class="footer-bottom-bar">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Todos los derechos reservados. Plantilla Shopify 2.0 Ultra-VIP.</p>
      <div class="payment-badges">
        <span> Pay</span>
        <span>G Pay</span>
        <span>PayPal</span>
        <span>Visa</span>
        <span>Mastercard</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer VIP",
  "settings": []
}
{% endschema %}
